<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.davidkodar.Klipp</id>
  <name>Klipp</name>
  <summary>Edit, grade and finish video on the GPU</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.davidkodar">
    <name>davidkodar</name>
  </developer>
  <description>
    <p>Klipp is a non-linear video editor for Linux. Picture work runs on the GPU in a linear-light colour pipeline.</p>
    <ul>
      <li>Timeline editing with linked sound, J and L cuts, and keyframes</li>
      <li>Colour page with node grading, scopes and HDR (HLG and PQ) export</li>
      <li>Titles, transitions, effects and compositing</li>
      <li>An assistant that works in the project over MCP</li>
    </ul>
  </description>
