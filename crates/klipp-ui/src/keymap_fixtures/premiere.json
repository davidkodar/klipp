   "documented": [
    "Q"
   ],
   "why": "Q is one Premiere command, Ripple Trim Previous Edit to Playhead, which trim_in_to_playhead already is in Klipp; a ripple trim of the selected clip would run with it"
  },
  "ripple_trim_tail": {
   "documented": [
    "W"
   ],
   "why": "W is one Premiere command, Ripple Trim Next Edit to Playhead, which trim_out_to_playhead already is in Klipp; a ripple trim of the selected clip would run with it"
  }
 }
