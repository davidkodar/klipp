 "actions": {
  "add_audio_crossfade": {
   "command": "Apply Audio Transition",
   "keys": [
    "Ctrl+Shift+D"
   ],
   "note": "Applies the default audio transition (a crossfade by default) at the edit nearest the playhead, as Klipp's AddDefaultTransition{audio:true} does."
  },
  "add_default_transition": {
   "command": "Apply Video Transition",
   "keys": [
    "Ctrl+D"
   ],
   "note": "Applies the default video transition at the nearest edit point (Klipp: 'the default transition at the nearest cut', #918). Premiere's 'Apply Default Transitions to Selection' (Shift+D) works on selected clips instead and is listed under editor_only."
  },
  "add_marker": {
   "command": "Add Marker",
   "keys": [
    "M"
   ],
   "note": "Markers menu. Note: about-comparison-view.html (2026-08-18) calls it 'Add Marker (Control or Command + M)', contradicting the shortcut table; the table is used."
  },
