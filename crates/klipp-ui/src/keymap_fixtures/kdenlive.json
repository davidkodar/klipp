 "deviations": {
  "trim_in_to_playhead": {
   "documented": [
    "("
   ],
   "why": "( is a character, not a key Klipp reads: on a US layout it is typed as Shift+9, the key Klipp binds"
  },
  "trim_out_to_playhead": {
   "documented": [
    ")"
   ],
   "why": ") is a character, not a key Klipp reads: on a US layout it is typed as Shift+0, the key Klipp binds"
  }
 },
 "klipp_adds": {
  "go_to_start": {
   "keys": [
    "Home"
   ],
   "why": "The page's Home is Go to Clip Start, a jump Klipp has no action for; Home to the timeline's start is kept beside Go to Project Start (Ctrl+Home), as every keymap has it (#2969)."
  },
  "go_to_end": {
   "keys": [
    "End"
   ],
   "why": "The page's End is Go to Clip End, a jump Klipp has no action for; End to the timeline's end is kept beside Go to Project End (Ctrl+End), as every keymap has it (#2969)."
  }
 }
