 "loose": {
  "add_default_transition": "LOOSE: Mix Clips makes a same-track mix at the cut between two clips; Klipp's default transition at the cut is the nearest action.",
  "toggle_multicam_mode": "LOOSE: Multitrack View shows every track's picture to cut between; Klipp's multicam mode is the nearest.",
  "trim_in_to_playhead": "LOOSE: Resize Item Start moves the selected item's start to the playhead; Klipp trims the clip under the playhead.",
  "trim_out_to_playhead": "LOOSE: Resize Item End moves the selected item's end to the playhead; Klipp trims the clip under the playhead.",
  "lift_clip": "Delete Selected Item leaves the gap: Klipp's lift.",
  "delete_clip": "Extract Clip removes the clip and closes the gap: Klipp's delete."
 },
