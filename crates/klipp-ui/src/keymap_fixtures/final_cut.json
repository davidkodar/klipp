  "copy_clip": {
   "command": "Copy",
   "keys": [
    "Ctrl+C"
   ]
  },
  "create_title": {
   "command": "Connect Default Title",
   "keys": [],
   "note": "Connects the default title at the playhead, as Klipp Create Title Clip does. Also listed as Add Basic Title (Control-T) under Effects. documented as Control-T; needs the Control key, which Klipp notation cannot write (Ctrl stands for Command)"
  },
  "cut_clip": {
   "command": "Cut",
   "keys": [
    "Ctrl+X"
   ]
  },
  "delete_clip": {
   "command": "Delete",
   "keys": [
    "Backspace"
   ],
   "note": "Mac Delete is Backspace; the page documents only Delete, not Forward Delete. In the timeline Delete removes the selection and closes the gap."
  },
  "deselect_all": {
   "command": "Deselect All",
   "keys": [
    "Ctrl+Shift+A"
   ]
  },
  "export": {
   "command": "Share to Default Destination",
   "keys": [
    "Ctrl+E"
   ],
   "note": "Exports the project with the default share destination."
  },
  "extend_edit": {
   "command": "Extend Edit",
   "keys": [
    "Shift+X"
   ],
   "note": "Extends the selected edit point to the skimmer or playhead, as Klipp Extend Edit to Playhead does. FCP E is Append to Storyline."
  },
  "extract_edit": {
   "command": "Delete",
   "keys": [
    "Backspace"
   ],
   "note": "Same FCP command as delete_clip: Delete on a timeline range selection removes it and closes the gap. FCP has no separate in/out extract command; binding both Klipp actions to one key is the caller's call."
  },
  "fit_to_window": {
   "command": "Zoom to Fit",
   "keys": [
    "Shift+Z"
   ]
  },
  "focus_panel_search": {
   "command": "Find",
   "keys": [
    "Ctrl+F"
   ],
   "note": "Shows/hides the Filter window (browser) or timeline index (timeline)."
  },
  "freeze_frame": {
   "command": "Insert/Connect Freeze Frame",
   "keys": [
    "Alt+F"
   ]
  },
  "go_to_end": {
   "command": "Go to End",
   "keys": [
    "End"
   ],
   "note": "page also gives the Fn-arrow laptop form"
  },
  "go_to_start": {
   "command": "Go to Beginning",
   "keys": [
    "Home"
   ],
   "note": "page also gives the Fn-arrow laptop form"
  },
  "import_media": {
   "command": "Import Media",
   "keys": [
    "Ctrl+I"
   ]
  },
  "insert_edit": {
   "command": "Insert",
   "keys": [
    "W"
   ]
  },
  "leave_compound": {
   "command": "Timeline History Back",
   "keys": [
    "Ctrl+["
   ],
   "note": "Timeline History Back returns from an opened compound clip to the parent timeline, as Klipp Leave Compound Clip does."
  },
  "lift_clip": {
   "command": "Replace with Gap",
   "keys": [
    "Shift+Backspace"
   ],
   "note": "Mac Shift-Delete is Shift+Backspace; Forward Delete is not documented."
  },
  "lift_edit": {
   "command": "Replace with Gap",
   "keys": [
    "Shift+Backspace"
   ],
   "note": "Same FCP command as lift_clip: on a range selection it leaves a gap. FCP has no separate in/out lift command; binding both Klipp actions to one key is the caller's call."
  },
  "match_frame_program_to_source": {
   "command": "Reveal Source in Browser",
   "keys": [
    "Shift+F"
   ],
   "note": "Reveals the timeline clip's source in the browser at the matching frame."
  },
