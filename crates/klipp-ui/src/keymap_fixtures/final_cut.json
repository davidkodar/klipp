  "toggle_color_panel": {
   "command": "Go to Color Inspector",
   "keys": [
    "Ctrl+6"
   ],
   "note": "LOOSE: makes the Color inspector active and adds Color Adjustments; it opens rather than toggles."
  },
  "toggle_fullscreen": {
   "command": "Play Full Screen",
   "keys": [
    "Ctrl+Shift+F"
   ],
   "note": "LOOSE: FCP plays full screen from the playhead; there is no plain full-screen toggle on the page."
  },
  "ungroup_clips": {
   "command": "Break Apart Clip Items",
   "keys": [
    "Ctrl+Shift+G"
   ],
   "note": "LOOSE: breaks a compound/storyline into its parts; FCP has no clip groups."
  }
