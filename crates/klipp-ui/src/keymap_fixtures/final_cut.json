  "play_around_edit": {
   "command": "Play Around",
   "keys": [
    "Shift+/"
   ],
   "note": "LOOSE: FCP plays around the playhead once; Klipp loops around the selected edit (or playhead). page says Shift-Question Mark (?); ? is Shift+/ on a US layout"
