# Maintainer: David Kodar <fds.bolin@gmail.com>
#
# Builds Klipp from the checkout this file sits in (../) and installs it
# as a pacman package. Run `makepkg -si` from this directory.
#
# Layout: the three binaries and the bundled LUTs live together under
# /usr/lib/klipp so Klipp's exe-adjacent asset lookup finds them, and
# /usr/bin/{klipp,klipp-mcp} are symlinks to the real binaries (Linux
# resolves them via /proc/self/exe, so the lookup still lands in
# /usr/lib/klipp).

pkgname=klipp-git
pkgrel=1
pkgdesc="GPU-accelerated non-linear video editor for Linux, with a linear-light colour pipeline and an AI assistant"
arch=('x86_64')
url="https://github.com/davidkodar/klipp"
license=('GPL-3.0-only')
provides=('klipp')
conflicts=('klipp')
# Runtime libraries the binaries link (directly or by dlopen) and the
# programs Klipp runs. ffmpeg pulls the whole codec / libplacebo /
# librsvg closure, which covers most of the transitive libraries.
depends=(
  'ffmpeg'              # libav* + swscale/swresample, and the ffmpeg/ffprobe binaries
  'vulkan-icd-loader'   # Vulkan: GPU playback, effects, scopes, and Whisper on the GPU
  'alsa-lib'            # audio output (cpal)
  'lilv'                # the LV2 audio-plugin host
  'fontconfig'          # font matching (fc-match) and text
  'freetype2'           # glyph rasterising
  'libxkbcommon'        # keyboard handling (Wayland)
  'wayland'             # the Wayland window (Omarchy / Hyprland)
  'gcc-libs'            # libstdc++ / libgcc_s
  'hicolor-icon-theme'  # the icon theme the launcher entry lives in
  'xdg-utils'           # opening files and links (xdg-open)
  'pciutils'            # GPU probing (lspci)
  'onnxruntime'         # libonnxruntime.so for the ONNX vision models (BiRefNet, RF-DETR), CPU by default
  'espeak-ng'           # phonemes for the Kokoro narration voices (Window > Narrate)
)
makedepends=(
  'rust'
  'cargo'
  'clang'
  'lld'
  'cmake'
  'pkgconf'
  'vulkan-headers'      # build-time: the Whisper GPU build compiles against these
  'shaderc'             # build-time: glslc compiles the Whisper shaders into the binary
  'git'
)
optdepends=(
  'cudnn: NVIDIA GPU acceleration for the ONNX vision models (with a CUDA onnxruntime)'
  'pipewire: PipeWire audio output (ALSA is used otherwise)'
  'frei0r-plugins: extra video effects through the frei0r host'
  'lsp-plugins-lv2: a large set of audio effects for the LV2 host'
  'calf: more LV2 audio effects'
  'piper-tts: the Piper narration voices'
  'libxi: running in an X11 session (Wayland needs none of these three)'
  'libxrandr: running in an X11 session'
  'libxkbcommon-x11: keyboard handling in an X11 session'
)
options=('!lto' '!debug')

# The source is the repository this PKGBUILD lives in; nothing is
# downloaded. `_root` is the checkout root (the parent of packaging/).
_root="${startdir}/.."

pkgver() {
  cd "$_root"
  # A monotonic version from git: r<commit-count>.<short-sha>.
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

# This recipe builds an existing checkout rather than fetching VCS sources.
# Resolve its version up front so makepkg does not rewrite the tracked recipe
# and leave a dirty file that blocks the user's next git pull.
if [[ -n ${KLIPP_RELEASE_VERSION:-} ]]; then
  # SemVer prereleases use a hyphen; Arch pkgver cannot contain one.
  # 0.20.0rc.1 sorts before 0.20.0 with vercmp.
  [[ $KLIPP_RELEASE_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || return 1
  pkgname=klipp
  pkgver=${KLIPP_RELEASE_VERSION//-/}
  conflicts=('klipp-git')
  depends+=('xdg-terminal-exec' 'sudo')
  unset -f pkgver
else
  pkgver=$(pkgver)
fi

build() {
  cd "$_root"
  if [[ $pkgname == klipp ]]; then
    # Override both Cargo config and environment flags. Native C/C++ parts
    # (Whisper/ggml) must use the same portable baseline as Rust.
    export CARGO_ENCODED_RUSTFLAGS=$'-C\x1flink-arg=-fuse-ld=lld\x1f-C\x1ftarget-cpu=x86-64'
    export CFLAGS='-O2 -march=x86-64 -mtune=generic'
    export CXXFLAGS="$CFLAGS"
    export GGML_NATIVE=OFF GGML_SSE42=OFF GGML_AVX=OFF GGML_AVX2=OFF
    export GGML_FMA=OFF GGML_F16C=OFF GGML_BMI2=OFF GGML_AVX_VNNI=OFF
    export GGML_AVX512=OFF GGML_AVX512_VBMI=OFF GGML_AVX512_VNNI=OFF
    export GGML_AVX512_BF16=OFF GGML_AMX_TILE=OFF GGML_AMX_INT8=OFF GGML_AMX_BF16=OFF
  fi
  # Lay out the Vulkan SDK directory the speech model's build expects.
  ./scripts/vulkan-sdk.sh
  # klipp-app is the editor, klipp-hdr-out the HDR reference presenter it
  # spawns, klipp-mcp the Model Context Protocol server for the agent.
  # Package from this checkout even if the user's Cargo config redirects
  # build output elsewhere. package() must consume this build's binaries.
  cargo build --release --locked --target-dir "$_root/target" \
    -p klipp-app -p klipp-hdr-out -p klipp-mcp
}

package() {
  cd "$_root"

  # Binaries and the bundled LUTs, kept together for the exe-adjacent lookup.
  install -Dm755 target/release/klipp-app "${pkgdir}/usr/lib/klipp/klipp"
  install -Dm755 target/release/klipp-hdr-out "${pkgdir}/usr/lib/klipp/klipp-hdr-out"
  install -Dm755 target/release/klipp-mcp "${pkgdir}/usr/lib/klipp/klipp-mcp"
  install -dm755 "${pkgdir}/usr/lib/klipp/assets"
  cp -r assets/luts "${pkgdir}/usr/lib/klipp/assets/luts"

  # The commands on PATH: the editor, and the MCP server an agent points at.
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /usr/lib/klipp/klipp "${pkgdir}/usr/bin/klipp"
  ln -s /usr/lib/klipp/klipp-mcp "${pkgdir}/usr/bin/klipp-mcp"

  if [[ $pkgname == klipp ]]; then
    install -Dm755 packaging/klipp-update "${pkgdir}/usr/bin/klipp-update"
  fi

  # Desktop entry and icons for the Omarchy app menu.
  install -Dm644 assets/klipp.desktop "${pkgdir}/usr/share/applications/klipp.desktop"
  for size in 16 22 24 32 48 64 128 256 512 1024; do
    icon="assets/branding/klipp-refined/klipp-icon-${size}.png"
    install -Dm644 "$icon" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/klipp.png"
  done
}
