# Build output.
target/
__pycache__/

# Logs written while Klipp runs.
*.log
*.log.[0-9]*

# Render output in progress, written next to the project.
*.partial
.partial

# Credentials and keys.
.env
.env.*
*.pem
*.key

# Model weights, downloaded on request.
*.pt
*.onnx
*.safetensors
*.gguf
ggml-*.bin

# Projects, media and screenshots made while working, in the root.
*.klipp
*.klipp.bak
*.klipp.autosave
/*.mp4
/*.mov
/*.mkv
/*.wav
/*.flac
/*.png
/*.jpg
/screenshots/

# Editor, assistant and session state.
.claude/
.codex/
.worktrees/
*.jsonl

# Packaging: makepkg's work folders and built packages.
/packaging/src/
/packaging/pkg/
/packaging/*.pkg.tar.zst

# Laid out by scripts/vulkan-sdk.sh: headers fetched or linked, not ours to keep.
/vendor/vulkan-sdk

# Icon sources; the exported icons are in assets/.
icon-src/

# Finished homepage videos are release attachments, not Git source assets.
/website/assets/*.mp4
